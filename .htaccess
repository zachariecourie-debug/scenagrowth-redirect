# SCENA Growth — Apache configuration for the OVH web hosting.
# Recreates what Genspark did server-side: canonical host, HTTPS, clean URLs,
# contact form endpoint, 404 page and security headers. /wa is a static page
# (wa/index.html) that opens WhatsApp with an EN or FR message.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Bare domains → www (permanent), keeping the path.
RewriteCond %{HTTP_HOST} ^(scenagrowth\.fr|carrosserielb\.fr)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# HTTP → HTTPS.
RewriteCond %{SERVER_PORT} 80
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Never serve repository or internal files.
RewriteRule (^|/)\.git(/|$) - [R=404,L]
RewriteRule ^README\.md$ - [R=404,L]

# /market-entry merged into /market-access (same search intent), 2026-10.
RewriteRule ^market-entry/?$ https://%{HTTP_HOST}/market-access [R=301,L]
RewriteRule ^fr/market-entry/?$ https://%{HTTP_HOST}/fr/market-access [R=301,L]

# Contact form endpoint.
RewriteRule ^api/contact/?$ api/contact.php [L]

# Direct requests for .../index.html → clean URL (one hop; internal rewrites are not affected).
RewriteCond %{THE_REQUEST} \s/+([^\s?]*?)/?index\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# Trailing slash → no trailing slash (permanent), except the home page.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# Clean URLs: /about → /about/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
