# SCENA Growth — Apache configuration for the OVH web hosting.
# Recreates what Genspark did server-side: canonical host, HTTPS, clean URLs,
# contact form endpoint, 404 page and security headers. /wa is a static page
# (wa/index.html) that opens WhatsApp with an EN or FR message.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Two domains, one folder: English on www.scenagrowth.com, French on www.scenagrowth.fr
# (the French files live in /fr and are served at the root of scenagrowth.fr).

# Bare domains → www (permanent), keeping the path.
RewriteCond %{HTTP_HOST} ^(scenagrowth\.fr|scenagrowth\.com|carrosserielb\.fr)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# HTTP → HTTPS.
RewriteCond %{SERVER_PORT} 80
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Instagram link (/ig on either domain): free guide in the visitor's language (temporary, language-dependent).
RewriteCond %{HTTP:Accept-Language} ^fr [NC]
RewriteRule ^ig/?$ https://www.scenagrowth.fr/guide-prix-parfum-dubai?utm_source=instagram&utm_medium=social&utm_campaign=guide_prix_dubai [R=302,L,NE]
RewriteRule ^ig/?$ https://www.scenagrowth.com/guide-perfume-price-dubai?utm_source=instagram&utm_medium=social&utm_campaign=guide_price_dubai [R=302,L,NE]

# Sample PDFs are now sent by email (2026-10-18): old public links → the examples page, on the right domain.
RewriteRule ^static/exemples/(?:sample-diagnostic-uae-france)\.pdf$ https://www.scenagrowth.com/examples [R=301,L]
RewriteRule ^static/exemples/ https://www.scenagrowth.fr/exemples [R=301,L]

# Brands & partners page removed (2026-10-18): one hop to About, on the right domain.
RewriteRule ^brands-partners/?$ https://www.scenagrowth.com/about [R=301,L]
RewriteRule ^(?:fr/)?marques-partenaires/?$ https://www.scenagrowth.fr/about [R=301,L]

# .com: French pages belong to scenagrowth.fr (one hop, /fr prefix dropped).
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.com$ [NC]
RewriteRule ^fr(?:/(.*))?$ https://www.scenagrowth.fr/$1 [R=301,L]

# .fr: old /fr/... addresses → same page without /fr (direct requests only, not internal rewrites).
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.fr$ [NC]
RewriteCond %{THE_REQUEST} \s/+fr(?:/([^\s?]*?))?/?(?:index\.html)?[\s?]
RewriteRule ^ https://www.scenagrowth.fr/%1 [R=301,L]

# .fr: English-only addresses (articles with English slugs) → scenagrowth.com.
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.fr$ [NC]
RewriteRule ^(guide-perfume-price-dubai|glossary|examples|insights/sell-in-uae-without-a-company|insights/sell-gulf-perfume-brand-france|insights/(?:dubai-company-setup-free-zone-or-mainland|product-to-shelf-france-distribution-map|test-uae-market-ecommerce|uae-brand-french-retail-meeting)|beauty-brand-launch-france|brands-partners|insights/beauty-retail-margins-france|insights/fragrance-sampling-scent-discovery|insights/progressive-market-entry|insights/find-fragrance-distributor-france|insights/montaji-registration-dubai-what-to-prepare|insights/find-distributor-uae|insights/create-your-own-perfume-brand|insights/cpnp-notification-responsible-person)/?$ https://www.scenagrowth.com/$1 [R=301,L]

# .com: French-only slugs → scenagrowth.fr.
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.com$ [NC]
RewriteRule ^(guide-prix-parfum-dubai|glossaire|exemples|insights/vendre-aux-emirats-sans-societe|insights/vendre-parfum-marque-golfe-france|lancement-marque-beaute-france|marques-partenaires|insights/marges-retail-beaute-france|insights/echantillonnage-experience-olfactive|insights/entree-progressive-nouveau-marche|insights/trouver-distributeur-parfum-france|insights/enregistrement-montaji-dubai-preparer|insights/trouver-distributeur-emirats|insights/creer-sa-marque-de-parfum|insights/notification-cpnp-personne-responsable|insights/(?:creer-societe-dubai-free-zone-ou-mainland|tester-marche-emirats-e-commerce|marque-emirienne-premier-rendez-vous-acheteur-france|du-produit-au-rayon-distribution-en-france))/?$ https://www.scenagrowth.fr/$1 [R=301,L]

# .fr: robots and sitemap of the French site.
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.fr$ [NC]
RewriteRule ^robots\.txt$ robots-fr.txt [L]
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.fr$ [NC]
RewriteRule ^sitemap\.xml$ sitemap-fr.xml [L]

# Never serve repository or internal files.
RewriteRule (^|/)\.git(/|$) - [R=404,L]
RewriteRule ^README\.md$ - [R=404,L]
RewriteRule ^private(/|$) - [R=404,L]

# /market-entry merged into /market-access (same search intent), 2026-10.
RewriteRule ^market-entry/?$ https://%{HTTP_HOST}/market-access [R=301,L]
RewriteRule ^fr/market-entry/?$ https://www.scenagrowth.fr/market-access [R=301,L]

# Contact form endpoint.
RewriteRule ^api/contact/?$ api/contact.php [L]

# Free guide: download form and opt-out link of its follow-up emails.
RewriteRule ^api/guide/?$ api/guide.php [L]
RewriteRule ^api/stop/?$ api/stop.php [L]

# Sample deliverables form (sends the PDFs by email).
RewriteRule ^api/exemples/?$ api/exemples.php [L]

# Direct requests for .../index.html → clean URL (one hop; internal rewrites are not affected).
RewriteCond %{THE_REQUEST} \s/+([^\s?]*?)/?index\.html[\s?] [NC]
RewriteRule ^ https://%{HTTP_HOST}/%1 [R=301,L]

# Trailing slash → no trailing slash (permanent), except the home page.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# .fr: serve the French files (/fr/...) at the root of scenagrowth.fr — internal rewrite.
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.fr$ [NC]
RewriteRule ^$ fr/index.html [L]
RewriteCond %{HTTP_HOST} ^www\.scenagrowth\.fr$ [NC]
RewriteCond %{REQUEST_URI} !^/(fr|static|api|wa)(/|$)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^(.+)$ fr/$1 [L]

# Clean URLs: /about → /about/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|webp|svg|ico|mp4)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
