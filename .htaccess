# SCENA Growth — Apache configuration for the OVH web hosting.
# Recreates what Genspark did server-side: canonical host, HTTPS, clean URLs,
# WhatsApp redirect, contact form endpoint, 404 page and security headers.

Options -Indexes -MultiViews
DirectorySlash Off
DirectoryIndex index.html
ErrorDocument 404 /404.html

RewriteEngine On

# Bare domains → www (permanent), keeping the path.
RewriteCond %{HTTP_HOST} ^(scenagrowth\.fr|carrosserielb\.fr)$ [NC]
RewriteRule ^ https://www.%1%{REQUEST_URI} [R=301,L]

# HTTP → HTTPS.
RewriteCond %{SERVER_PORT} 80
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# Never serve repository or internal files.
RewriteRule (^|/)\.git(/|$) - [R=404,L]
RewriteRule ^README\.md$ - [R=404,L]

# WhatsApp CTA: the number stays out of the pages (same message as on Genspark).
RewriteRule ^wa/?$ https://wa.me/33651366670?text=Hello\%2C\%20thanks!\%20I\%E2\%80\%99d\%20like\%20to\%20talk\%20about\%20growing\%20between\%20France\%20and\%20the\%20UAE. [R=302,NE,L]

# Contact form endpoint.
RewriteRule ^api/contact/?$ api/contact.php [L]

# Trailing slash → no trailing slash (permanent), except the home page.
RewriteCond %{REQUEST_URI} !^/$
RewriteRule ^(.+)/$ https://%{HTTP_HOST}/$1 [R=301,L]

# Clean URLs: /about → /about/index.html
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.+)$ $1/index.html [L]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2|jpg|jpeg|png|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>
